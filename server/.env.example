# Copy this file to .env (gitignored — never commit a real key) and fill
# in a real key to run a live path. Leave both empty to run the local
# scripted mock instead — that's the default, safe for demos and UI work,
# no key required.
#
# If GEMINI_API_KEY is set, it takes priority over ANTHROPIC_API_KEY (see
# active_provider() in main.py) — so if you want to run Claude instead
# while a Gemini key is also present, leave GEMINI_API_KEY blank rather
# than relying on which one is "more set."
#
# STATUS: both live paths are fully implemented but NOT yet reviewed by
# anyone with clinical/crisis background. Do not point a deployment of
# this server with a real key at real users until that review has
# happened — see docs/RISK_DETECTION_SPEC.md and docs/AGENT_GUARDRAILS_SPEC.md.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
